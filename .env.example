# Configure no Netlify como variáveis privadas. Nunca em dist ou em prefixos públicos.
GOOGLE_SHEET_ID=1BcHzuaOFOm2MMs11l-BNBzMmlnzdHdPrnhSnIPk7z30
GROQ_DASHBOARD_API_KEY=
GROQ_REPORT_API_KEY=

# Leitura e gravação da planilha: compartilhe-a como Editor com esta conta.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Obrigatórias para proteger lançamentos, fotos e relatórios.
REPORTS_ACCESS_CODE=
REPORTS_SESSION_SECRET=

# Pasta privada em que fotos e PDFs serão gravados.
# Com conta de serviço, use um Drive compartilhado e informe os dois IDs.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Alternativa Google Workspace: impersonação autorizada pelo administrador.
GOOGLE_DRIVE_IMPERSONATE_EMAIL=

# Alternativa para Meu Drive: OAuth de uma pessoa (use as três juntas).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Nome que aparece nos PDFs automáticos.
REPORT_OWNER=Técnica de Segurança do Trabalho

# Opcional: origem exata publicada, sem barra final.
SITE_URL=
